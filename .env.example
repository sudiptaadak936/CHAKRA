# ==========================================
# CHAKRA Environment Configuration Example
# Copy to .env and fill in real values
# ==========================================


# ==========================================
# PostgreSQL Configuration
# ==========================================

POSTGRES_DB=chakra_db
POSTGRES_USER=chakra_user
POSTGRES_PASSWORD=chakra_secure_password

# Port exposed on the host
POSTGRES_HOST_PORT=5432


# ==========================================
# Neo4j Community Edition Configuration
# ==========================================

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chakra_neo4j_password


# ==========================================
# Redis Configuration
# ==========================================

# Port exposed on the host
REDIS_HOST_PORT=6379
REDIS_PASSWORD=


# ==========================================
# Backend Configuration
# ==========================================

BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO


# ==========================================
# Frontend Configuration
# ==========================================

FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000


# ==========================================
# Blockchain / Intelligence Provider API Keys
# ==========================================
#
# IMPORTANT:
# These are backend-only secrets.
# NEVER prefix these with VITE_.
# NEVER expose them to the React frontend.
#

TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
SOLSCAN_API_KEY=
CHAINABUSE_API_KEY=


# ==========================================
# BitcoinAbuse
# ==========================================
#
# No separate BitcoinAbuse API key is required.
# BitcoinAbuse functionality is handled through
# the Chainabuse integration where applicable.
#